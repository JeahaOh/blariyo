# Blariyo shared development example. Replace placeholders in a private .env.dev file.
BLARIYO_ENV=dev
NODE_ENV=development

# Docker API listens on its container network; do not publish this port publicly.
# For direct execution on one computer use HOST=127.0.0.1 and NUXT_CORE_ORIGIN=http://127.0.0.1:3100.
HOST=0.0.0.0
PORT=3100
# Must match NUXT_SERVICE_TOKEN; inject the same secret into API and Web.
SERVICE_TOKEN=<dev-service-token>
DATABASE_URL=postgres://dev_app_user@dev-db.internal:5432/blariyo_dev
STORAGE_MODE=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PRIVATE_BUCKET=blariyo-dev-media-private
R2_PUBLIC_BUCKET=blariyo-dev-media-public
R2_PRIVATE_ACCESS_KEY_ID=<dev-private-key-id>
R2_PRIVATE_SECRET_ACCESS_KEY=<dev-private-secret>
R2_PUBLIC_ACCESS_KEY_ID=<dev-public-key-id>
R2_PUBLIC_SECRET_ACCESS_KEY=<dev-public-secret>
CACHE_ZONE_ID=<dev-zone-id>
CACHE_PURGE_TOKEN=<dev-cache-purge-token>
SITE_ORIGIN=https://dev.blariyo.com
IMAGE_ORIGIN=https://dev-media.blariyo.com

NUXT_CORE_ORIGIN=http://api:3100
NUXT_PUBLIC_SITE_ORIGIN=https://dev.blariyo.com
NUXT_PUBLIC_IMAGE_ORIGIN=https://dev-media.blariyo.com
NUXT_ADMIN_AUTH_MODE=access
NUXT_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
NUXT_ACCESS_AUDIENCE=<dev-admin-audience>
NUXT_ADMIN_OPERATORS_FILE=/run/secrets/admin-operators.json
NUXT_SERVICE_TOKEN=<dev-service-token>
NUXT_ACTOR_SECRET=<dev-actor-secret>

COLLECTOR_DB_URL=jdbc:postgresql://dev-db.internal:5432/blariyo_dev
COLLECTOR_DB_USER=collector_dev
COLLECTOR_DB_PASSWORD=<dev-collector-db-password>
COLLECTOR_OBJECT_STORE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
COLLECTOR_OBJECT_STORE_S3_BUCKET=blariyo-dev-collect-private
COLLECTOR_OBJECT_STORE_S3_ACCESS_KEY_ID=<dev-collect-key-id>
COLLECTOR_OBJECT_STORE_S3_SECRET_ACCESS_KEY=<dev-collect-secret>

# Enable only after API V008 and batch migrations plus role grants are validated.
COLLECT_BATCH_REVIEW_ENABLED=false
NUXT_COLLECT_BATCH_REVIEW_ENABLED=false
# API uses GET-only credentials for the batch bucket, separate from batch write credentials.
COLLECT_READER_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
COLLECT_READER_S3_BUCKET=blariyo-dev-collect-private
COLLECT_READER_S3_ACCESS_KEY_ID=<dev-collect-read-only-key-id>
COLLECT_READER_S3_SECRET_ACCESS_KEY=<dev-collect-read-only-secret>

# Optional direct Discord batch process; disabled unless `discord --write-db` is run.
# Secrets directory contains private discord-token and base64 32-byte request-key files.
# COLLECTOR_SECRETS_DIRECTORY=/absolute/private/collector-secrets
# COLLECTOR_DISCORD_GUILDS=
# COLLECTOR_DISCORD_CHANNELS=
# COLLECTOR_DISCORD_USERS=
# COLLECTOR_DISCORD_ROLES=
COLLECTOR_DISCORD_REGISTER_COMMANDS=false
