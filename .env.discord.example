# Blariyo Discord 공통 템플릿. 실제 ID와 비밀값을 입력하지 않는다.
# local/prod 파일이 없을 때 필요한 환경으로 복사한다.
#   cp -n .env.discord.example .env.discord.local
#   cp -n .env.discord.example .env.discord.prod
# local은 테스트 채널, prod는 운영 채널의 ID를 입력한다.
# 이 파일은 Discord 설정만 포함한다. DB/object 설정은 같은 환경으로 별도 준비한다.

# 서버 ID. 여러 값은 쉼표로 구분한다.
COLLECTOR_DISCORD_GUILDS=""
# 허용할 채널 ID. 여러 값은 쉼표로 구분한다.
COLLECTOR_DISCORD_CHANNELS=""
# 명령을 실행할 본인 사용자 ID. 여러 값은 쉼표로 구분한다.
COLLECTOR_DISCORD_USERS=""
# 역할 단위로 허용할 경우에만 입력한다. 본인 ID만 사용할 때는 비워 둔다.
COLLECTOR_DISCORD_ROLES=""

# 최초 테스트 서버의 명령 등록 시에만 true로 바꾸고, 등록 후 false로 되돌린다.
COLLECTOR_DISCORD_REGISTER_COMMANDS=false
# discord-token, request-key 파일을 보관할 소유자 전용 디렉터리의 절대 경로.
# 토큰과 키 원문은 이 파일에 넣지 않는다. request-key는 32바이트 키의 base64다.
COLLECTOR_SECRETS_DIRECTORY=""

# 자동으로 읽히지 않는다. 실행할 터미널에서 선택한 환경 파일을 불러온다.
#   set -a
#   source .env.discord.local
#   set +a
# prod 작업은 위 source 경로를 .env.discord.prod로 바꾼다.
# 파일을 불러오는 것만으로 봇이 실행되거나 DB/object 환경이 전환되지는 않는다.
# 연결 절차: apps/collector/ops/README.md의 Direct Discord queue (V005).
