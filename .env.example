# Blariyo environment template index.
# Copy one of the per-environment templates instead of using this file directly:
#   cp .env.local.example .env.local
#   cp .env.dev.example .env.dev
#   cp .env.stage.example .env.stage
#   cp .env.prod.example .env.prod
#
# Runtime rule:
# - DB/object storage keys store paths only.
# - SITE_ORIGIN and IMAGE_ORIGIN provide the environment-specific host/base URL.
# - Public image URL = IMAGE_ORIGIN + '/' + publicStorageKey.
# - Collect preview media remains private and is served only through authenticated admin/proxy routes.

# Optional direct Discord batch process; disabled unless `discord --write-db` is run.
# Secrets directory contains private discord-token and base64 32-byte request-key files.
# COLLECTOR_SECRETS_DIRECTORY=/absolute/private/collector-secrets
# COLLECTOR_DISCORD_GUILDS=
# COLLECTOR_DISCORD_CHANNELS=
# COLLECTOR_DISCORD_USERS=
# COLLECTOR_DISCORD_ROLES=
COLLECTOR_DISCORD_REGISTER_COMMANDS=false
