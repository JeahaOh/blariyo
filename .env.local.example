# Blariyo local development example. No real secrets.
BLARIYO_ENV=local
NODE_ENV=development

# API/Core
HOST=127.0.0.1
PORT=3100
# Must match NUXT_SERVICE_TOKEN; inject the same secret into API and Web.
SERVICE_TOKEN=replace-with-shared-local-service-token-32-plus-chars
DATABASE_URL=postgres://blariyo_api_local:replace-with-api-role-password@127.0.0.1:5439/blariyo_local
STORAGE_MODE=local
STORAGE_ROOT=.local-data/media
SITE_ORIGIN=http://localhost:3000
# Host/base path for public image URLs. Stored image keys remain relative paths.
IMAGE_ORIGIN=http://localhost:3000/media

# Web/BFF
NUXT_CORE_ORIGIN=http://127.0.0.1:3100
NUXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
NUXT_PUBLIC_IMAGE_ORIGIN=http://localhost:3000/media
NUXT_ADMIN_AUTH_MODE=local
NUXT_LOCAL_ADMIN_TOKEN=replace-with-local-only-token-32-plus-chars
NUXT_SERVICE_TOKEN=replace-with-shared-local-service-token-32-plus-chars
NUXT_ACTOR_SECRET=replace-with-local-actor-secret-32-plus-chars

# Collector direct batch local write/readback
COLLECTOR_SOURCES_FILE=apps/collector/ops/reference-sites.sources.example.json
COLLECTOR_DB_URL=jdbc:postgresql://127.0.0.1:5439/blariyo_local
COLLECTOR_DB_USER=blariyo_batch_local
COLLECTOR_DB_PASSWORD=replace-with-batch-role-password
COLLECTOR_OBJECT_STORE_DIRECTORY=.local-data/collector-objects

# Enable only after API V008 and batch migrations plus role grants are validated.
COLLECT_BATCH_REVIEW_ENABLED=false
NUXT_COLLECT_BATCH_REVIEW_ENABLED=false
COLLECT_READER_DIRECTORY=.local-data/collector-objects
# Fixed local scripts read separately generated credentials from the ignored
# .local-data/development/batch-config.json; never paste real values here.

# Optional direct Discord batch process; disabled unless `discord --write-db` is run.
# Secrets directory contains private discord-token and base64 32-byte request-key files.
# COLLECTOR_SECRETS_DIRECTORY=/absolute/private/collector-secrets
# COLLECTOR_DISCORD_GUILDS=
# COLLECTOR_DISCORD_CHANNELS=
# COLLECTOR_DISCORD_USERS=
# COLLECTOR_DISCORD_ROLES=
COLLECTOR_DISCORD_REGISTER_COMMANDS=false
