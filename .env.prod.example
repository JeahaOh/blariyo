# Blariyo production example. Do not put real secrets in git or shell history.
BLARIYO_ENV=prod
NODE_ENV=production

# Docker API listens on its container network; do not publish this port publicly.
# For direct execution on one computer use HOST=127.0.0.1 and NUXT_CORE_ORIGIN=http://127.0.0.1:3100.
HOST=0.0.0.0
PORT=3100
# Must match NUXT_SERVICE_TOKEN; inject the same secret into API and Web.
SERVICE_TOKEN=<prod-service-token>
DB_HOST=postgresql
DB_PORT=5432
DB_NAME=blariyo
APP_DB_USER=blariyo_app
APP_DB_PASSWORD_FILE=/run/secrets/app-db-password
STORAGE_MODE=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PRIVATE_BUCKET=blariyo-media-private
R2_PUBLIC_BUCKET=blariyo-media-public
R2_PRIVATE_ACCESS_KEY_ID=<prod-private-key-id>
R2_PRIVATE_SECRET_ACCESS_KEY=<prod-private-secret>
R2_PUBLIC_ACCESS_KEY_ID=<prod-public-key-id>
R2_PUBLIC_SECRET_ACCESS_KEY=<prod-public-secret>
CACHE_ZONE_ID=<prod-zone-id>
CACHE_PURGE_TOKEN=<prod-cache-purge-token>
SITE_ORIGIN=https://blariyo.com
IMAGE_ORIGIN=https://media.blariyo.com
LEGAL_CONFIG={"operatorDisplayName":"(확정 필요)","contactEmail":"(확정 필요)","rightsEmail":"(확정 필요)","privacyEmail":"(확정 필요)","privacyOfficer":"(확정 필요)"}
MAINTENANCE_READ_ONLY=false

NUXT_CORE_ORIGIN=http://api:3100
NUXT_PUBLIC_SITE_ORIGIN=https://blariyo.com
NUXT_PUBLIC_IMAGE_ORIGIN=https://media.blariyo.com
NUXT_ADMIN_AUTH_MODE=access
NUXT_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
NUXT_ACCESS_AUDIENCE=<prod-admin-audience>
NUXT_ADMIN_OPERATORS_FILE=/run/secrets/admin-operators.json
NUXT_SERVICE_TOKEN=<prod-service-token>
NUXT_ACTOR_SECRET=<prod-actor-secret>
NUXT_TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# Batch collector usually runs on a separate operator machine, not the public web/API host.
COLLECTOR_DB_URL=jdbc:postgresql://<private-db-host>:5432/blariyo
COLLECTOR_DB_USER=collector_prod
COLLECTOR_DB_PASSWORD=<prod-collector-db-password>
COLLECTOR_OBJECT_STORE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
COLLECTOR_OBJECT_STORE_S3_BUCKET=blariyo-collect-private
COLLECTOR_OBJECT_STORE_S3_ACCESS_KEY_ID=<prod-collect-key-id>
COLLECTOR_OBJECT_STORE_S3_SECRET_ACCESS_KEY=<prod-collect-secret>

# Enable only after API V008 and batch migrations plus role grants are validated.
COLLECT_BATCH_REVIEW_ENABLED=false
NUXT_COLLECT_BATCH_REVIEW_ENABLED=false
# API uses GET-only credentials for the batch bucket, separate from batch write credentials.
COLLECT_READER_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
COLLECT_READER_S3_BUCKET=blariyo-collect-private
COLLECT_READER_S3_ACCESS_KEY_ID=<prod-collect-read-only-key-id>
COLLECT_READER_S3_SECRET_ACCESS_KEY=<prod-collect-read-only-secret>

# Optional direct Discord batch process; disabled unless `discord --write-db` is run.
# Secrets directory contains private discord-token and base64 32-byte request-key files.
# COLLECTOR_SECRETS_DIRECTORY=/absolute/private/collector-secrets
# COLLECTOR_DISCORD_GUILDS=
# COLLECTOR_DISCORD_CHANNELS=
# COLLECTOR_DISCORD_USERS=
# COLLECTOR_DISCORD_ROLES=
COLLECTOR_DISCORD_REGISTER_COMMANDS=false
