# Blariyo staging example. Staging mirrors production topology but uses isolated DB/R2 buckets.
BLARIYO_ENV=stage
NODE_ENV=production

# Docker API listens on its container network; do not publish this port publicly.
# For direct execution on one computer use HOST=127.0.0.1 and NUXT_CORE_ORIGIN=http://127.0.0.1:3100.
HOST=0.0.0.0
PORT=3100
# Must match NUXT_SERVICE_TOKEN; inject the same secret into API and Web.
SERVICE_TOKEN=<stage-service-token>
DB_HOST=stage-db.internal
DB_PORT=5432
DB_NAME=blariyo_stage
APP_DB_USER=blariyo_app
APP_DB_PASSWORD_FILE=/run/secrets/app-db-password
STORAGE_MODE=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PRIVATE_BUCKET=blariyo-stage-media-private
R2_PUBLIC_BUCKET=blariyo-stage-media-public
R2_PRIVATE_ACCESS_KEY_ID=<stage-private-key-id>
R2_PRIVATE_SECRET_ACCESS_KEY=<stage-private-secret>
R2_PUBLIC_ACCESS_KEY_ID=<stage-public-key-id>
R2_PUBLIC_SECRET_ACCESS_KEY=<stage-public-secret>
CACHE_ZONE_ID=<stage-zone-id>
CACHE_PURGE_TOKEN=<stage-cache-purge-token>
SITE_ORIGIN=https://stage.blariyo.com
IMAGE_ORIGIN=https://stage-media.blariyo.com
LEGAL_CONFIG={"operatorDisplayName":"(stage)","contactEmail":"stage@example.invalid","rightsEmail":"stage@example.invalid","privacyEmail":"stage@example.invalid","privacyOfficer":"(stage)"}

NUXT_CORE_ORIGIN=http://api:3100
NUXT_PUBLIC_SITE_ORIGIN=https://stage.blariyo.com
NUXT_PUBLIC_IMAGE_ORIGIN=https://stage-media.blariyo.com
NUXT_ADMIN_AUTH_MODE=access
NUXT_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
NUXT_ACCESS_AUDIENCE=<stage-admin-audience>
NUXT_ADMIN_OPERATORS_FILE=/run/secrets/admin-operators.json
NUXT_SERVICE_TOKEN=<stage-service-token>
NUXT_ACTOR_SECRET=<stage-actor-secret>

COLLECTOR_DB_URL=jdbc:postgresql://stage-db.internal:5432/blariyo_stage
COLLECTOR_DB_USER=collector_stage
COLLECTOR_DB_PASSWORD=<stage-collector-db-password>
COLLECTOR_OBJECT_STORE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
COLLECTOR_OBJECT_STORE_S3_BUCKET=blariyo-stage-collect-private
COLLECTOR_OBJECT_STORE_S3_ACCESS_KEY_ID=<stage-collect-key-id>
COLLECTOR_OBJECT_STORE_S3_SECRET_ACCESS_KEY=<stage-collect-secret>

# Enable only after API V008 and batch migrations plus role grants are validated.
COLLECT_BATCH_REVIEW_ENABLED=false
NUXT_COLLECT_BATCH_REVIEW_ENABLED=false
# API uses GET-only credentials for the batch bucket, separate from batch write credentials.
COLLECT_READER_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
COLLECT_READER_S3_BUCKET=blariyo-stage-collect-private
COLLECT_READER_S3_ACCESS_KEY_ID=<stage-collect-read-only-key-id>
COLLECT_READER_S3_SECRET_ACCESS_KEY=<stage-collect-read-only-secret>

# Optional direct Discord batch process; disabled unless `discord --write-db` is run.
# Secrets directory contains private discord-token and base64 32-byte request-key files.
# COLLECTOR_SECRETS_DIRECTORY=/absolute/private/collector-secrets
# COLLECTOR_DISCORD_GUILDS=
# COLLECTOR_DISCORD_CHANNELS=
# COLLECTOR_DISCORD_USERS=
# COLLECTOR_DISCORD_ROLES=
COLLECTOR_DISCORD_REGISTER_COMMANDS=false
