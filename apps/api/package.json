{
  "name": "blariyo-api",
  "version": "1.0.0",
  "description": "Blariyo API Server",
  "main": "src/app.js",
  "engines": {
    "node": "24.18.x"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "DEBUG=express:* nodemon --inspect src/app.js",
    "test": "docker compose -f docker-compose.test.yml up -d --wait && NODE_ENV=test jest && docker compose -f docker-compose.test.yml down",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:setup": "NODE_ENV=test node src/tests/setup.js",
    "test:docker:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:docker:down": "docker compose -f docker-compose.test.yml down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  }
}
