#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
jar=${COLLECTOR_JAR:-"$root/apps/collector/build/libs/blariyo-collector-0.1.0.jar"}
java_cmd=${JAVA_HOME:+"$JAVA_HOME/bin/"}java
export COLLECTOR_SOURCES_FILE=${COLLECTOR_SOURCES_FILE:-"$root/apps/collector/ops/reference-sites.sources.example.json"}
exec "$java_cmd" -Dloader.main=com.blariyo.collector.ops.BatchMain -cp "$jar" org.springframework.boot.loader.launch.PropertiesLauncher "$@"
