{
  "name": "blariyo-m0-core",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint -w @blariyo/api && npm run lint -w @blariyo/web && npm run lint:scripts && npm run lint:tests && npm run lint:quality-rules",
    "quality:verify": "node scripts/quality/verify.ts",
    "quality:receipt": "node scripts/quality/receipt.ts",
    "quality:review": "node scripts/quality/review-guards.ts",
    "hooks:install": "node scripts/git-hooks.mjs install",
    "hooks:check": "node scripts/git-hooks.mjs check",
    "test:ci": "python3 -B -m unittest discover -s scripts/ci -p 'test_*.py'",
    "test:git-hooks": "node --test scripts/git-hooks.test.mjs",
    "dev:web": "npm run dev -w @blariyo/web",
    "dev:api": "npm run dev -w @blariyo/api",
    "build": "npm run contracts:generate && npm run build -w @blariyo/api && npm run build -w @blariyo/web",
    "test": "node --test tests/*.test.ts scripts/git-hooks.test.mjs",
    "contracts:generate": "node scripts/generate-contracts.ts",
    "db:migrate": "node apps/api/dist/commands/migrate.js",
    "posts:publish-due": "node apps/api/dist/commands/command.js posts:publish-due",
    "outbox:run": "node apps/api/dist/commands/command.js outbox:run",
    "cleanup:run": "node apps/api/dist/commands/command.js cleanup:run",
    "policies:publish": "node apps/api/dist/commands/command.js policies:publish",
    "test:integration": "npm run test:nest",
    "test:browser": "npm run build && node --test --test-concurrency=1 tests/browser/*.test.ts",
    "test:browser:docker": "npm run build && node scripts/local/playwright-tests.mjs",
    "test:web-cache": "npm run build -w @blariyo/web && node --test tests/http/web-cache.test.ts",
    "test:docker": "node scripts/test-docker.ts",
    "test:database-roles": "npm run build -w @blariyo/api && apps/collector/gradlew -p apps/collector testClasses fixtureClasspath && node scripts/test-database-roles.ts",
    "test:architecture": "npm run build:test -w @blariyo/api && node --test tests/architecture.test.ts",
    "collection:transition": "node apps/api/dist/commands/collection-transition.js",
    "test:fixtures": "node scripts/prepare-collector-fixtures.mjs",
    "test:collector": "node scripts/test-collector-readback.mjs",
    "test:backup": "node --test deploy/backup/test-drive.mjs deploy/backup/test-backup-jobs.mjs deploy/operations/test-collect-retention.mjs && python3 -B deploy/backup/test-runner.py",
    "test:direct-identity": "npm run build -w @blariyo/api && apps/collector/gradlew -p apps/collector testClasses fixtureClasspath && node scripts/test-direct-identity.mjs",
    "test:nest": "npm run test:fixtures && npm run build && npm run build:test -w @blariyo/api && node scripts/test-nest-integration.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "lint:scripts": "eslint --config scripts/eslint.config.mjs scripts/**/*.ts",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "lint:tests": "eslint --config tests/eslint.config.mjs tests/**/*.ts",
    "typecheck:web": "npm run typecheck -w @blariyo/web",
    "test:spring": "npm run build && apps/collector/gradlew -p apps/collector test bootJar fixtureClasspath && node --test --test-concurrency=1 tests/spring/*.test.ts",
    "verify:migration": "node scripts/verify-migration.ts",
    "lint:quality-rules": "oxlint --config oxlint.config.ts apps/api/src apps/api/test apps/web/app apps/web/server apps/web/shared packages/contracts/src scripts tests",
    "typecheck:quality-rules": "tsc -p tools/oxlint/tsconfig.json",
    "quality:audit": "node scripts/quality/audit.ts",
    "collection:auto-publish": "node apps/api/dist/commands/command.js collection:auto-publish"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "^1.55.0",
    "openapi-typescript": "^7.10.1",
    "oxlint": "1.78.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
