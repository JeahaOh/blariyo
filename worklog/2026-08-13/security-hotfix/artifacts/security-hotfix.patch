diff --git a/apps/api/src/utils/loggerFactory.js b/apps/api/src/utils/loggerFactory.js
new file mode 100644
index 0000000..b04560b
--- /dev/null
+++ b/apps/api/src/utils/loggerFactory.js
@@ -0,0 +1,43 @@
+const winston = require('winston');
+
+const allowedFields = new Set([
+  'level',
+  'message',
+  'timestamp',
+  'method',
+  'path',
+  'statusCode',
+  'durationMs',
+  'requestId',
+  'port'
+]);
+
+const allowlistedMetadata = winston.format((info) => {
+  Object.keys(info).forEach((key) => {
+    if (!allowedFields.has(key)) {
+      delete info[key];
+    }
+  });
+  return info;
+});
+
+const createAppLogger = ({ transports } = {}) => winston.createLogger({
+  level: 'info',
+  format: winston.format.combine(
+    allowlistedMetadata(),
+    winston.format.timestamp(),
+    winston.format.json()
+  ),
+  transports: transports || [
+    new winston.transports.Console({
+      format: winston.format.combine(
+        winston.format.colorize(),
+        winston.format.simple()
+      )
+    }),
+    new winston.transports.File({ filename: 'error.log', level: 'error' }),
+    new winston.transports.File({ filename: 'combined.log' })
+  ]
+});
+
+module.exports = { createAppLogger };
diff --git a/apps/api/tests/logging.security.test.js b/apps/api/tests/logging.security.test.js
new file mode 100644
index 0000000..4f8cef6
--- /dev/null
+++ b/apps/api/tests/logging.security.test.js
@@ -0,0 +1,155 @@
+const { Writable } = require('stream');
+const express = require('express');
+const request = require('supertest');
+const winston = require('winston');
+const { createAppLogger } = require('../src/utils/loggerFactory');
+const { createLoggingMiddleware } = require('../src/middlewares/loggingMiddleware');
+const { createErrorHandler } = require('../src/middlewares/errorHandler');
+
+const CANARY = 'BLARIYO_LOG_CANARY_DO_NOT_RECORD';
+
+const createMemoryLogger = () => {
+  const entries = [];
+  const stream = new Writable({
+    write(chunk, encoding, callback) {
+      entries.push(chunk.toString());
+      callback();
+    }
+  });
+  const logger = createAppLogger({
+    transports: [new winston.transports.Stream({ stream })]
+  });
+
+  return { entries, logger };
+};
+
+const createTestApp = (logger) => {
+  const app = express();
+  const router = express.Router();
+
+  app.use(express.json());
+  app.use(createLoggingMiddleware(logger));
+
+  router.post('/:user_id', (req, res) => res.status(204).end());
+  router.get('/error/:user_id', (req, res, next) => next(new Error(CANARY)));
+  app.use('/api/v1/users', router);
+  app.use((req, res) => res.status(404).json({ success: false }));
+  app.use(createErrorHandler(logger));
+
+  return app;
+};
+
+describe('민감정보 로그 차단', () => {
+  it('실제 Express matched route에서 입력값 없이 라우트 템플릿만 기록한다', async () => {
+    const { entries, logger } = createMemoryLogger();
+    const app = createTestApp(logger);
+
+    await request(app)
+      .post(`/api/v1/users/${CANARY}?token=${CANARY}`)
+      .set('Authorization', `Bearer ${CANARY}`)
+      .set('Cookie', `session=${CANARY}`)
+      .send({ user_pswd: CANARY, token: CANARY })
+      .expect(204);
+
+    await new Promise((resolve) => logger.on('finish', resolve).end());
+    const output = entries.join('');
+    const records = entries.map((entry) => JSON.parse(entry));
+
+    expect(output).not.toContain(CANARY);
+    expect(records).toHaveLength(2);
+    expect(records[0]).toEqual(expect.objectContaining({
+      level: 'info',
+      message: 'Request Start',
+      method: 'POST',
+      requestId: expect.any(String),
+      timestamp: expect.any(String)
+    }));
+    expect(records[1]).toEqual(expect.objectContaining({
+      level: 'info',
+      message: 'Request End',
+      method: 'POST',
+      path: '/:user_id',
+      statusCode: 204,
+      durationMs: expect.any(Number),
+      requestId: records[0].requestId,
+      timestamp: expect.any(String)
+    }));
+  });
+
+  it('실제 Express unmatched 요청은 raw URL 대신 unmatched로 기록한다', async () => {
+    const { entries, logger } = createMemoryLogger();
+    const app = createTestApp(logger);
+
+    await request(app)
+      .get(`/not-found/${CANARY}?token=${CANARY}`)
+      .set('Authorization', `Bearer ${CANARY}`)
+      .set('Cookie', `session=${CANARY}`)
+      .expect(404);
+
+    await new Promise((resolve) => logger.on('finish', resolve).end());
+    const output = entries.join('');
+    const records = entries.map((entry) => JSON.parse(entry));
+
+    expect(output).not.toContain(CANARY);
+    expect(records[1]).toEqual(expect.objectContaining({
+      path: 'unmatched',
+      statusCode: 404
+    }));
+  });
+
+  it('오류 원문과 모든 요청 입력 canary를 실제 Winston 출력에서 제거한다', async () => {
+    const { entries, logger } = createMemoryLogger();
+    const app = createTestApp(logger);
+
+    await request(app)
+      .get(`/api/v1/users/error/${CANARY}?token=${CANARY}`)
+      .set('Authorization', `Bearer ${CANARY}`)
+      .set('Cookie', `session=${CANARY}`)
+      .expect(500, {
+        success: false,
+        message: '서버 오류가 발생했습니다.'
+      });
+
+    await new Promise((resolve) => logger.on('finish', resolve).end());
+    const output = entries.join('');
+    const records = entries.map((entry) => JSON.parse(entry));
+
+    expect(output).not.toContain(CANARY);
+    expect(records).toEqual(expect.arrayContaining([
+      expect.objectContaining({
+        level: 'error',
+        message: 'Request error',
+        method: 'GET',
+        statusCode: 500
+      }),
+      expect.objectContaining({
+        level: 'info',
+        message: 'Request End',
+        path: '/error/:user_id',
+        statusCode: 500
+      })
+    ]));
+  });
+
+  it('오류 객체 status와 message에 관계없이 기존 500 응답 계약을 유지한다', async () => {
+    const { logger } = createMemoryLogger();
+    const app = express();
+
+    app.use(createLoggingMiddleware(logger));
+    app.get('/contract', (req, res, next) => {
+      const error = new Error(CANARY);
+      error.status = 401;
+      next(error);
+    });
+    app.use(createErrorHandler(logger));
+
+    await request(app)
+      .get('/contract')
+      .expect(500, {
+        success: false,
+        message: '서버 오류가 발생했습니다.'
+      });
+
+    await new Promise((resolve) => logger.on('finish', resolve).end());
+  });
+});
