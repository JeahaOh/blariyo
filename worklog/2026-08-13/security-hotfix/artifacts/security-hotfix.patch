+++ b/apps/api/tests/sensitive-log-source.security.test.js
@@ -0,0 +1,36 @@
+const fs = require('fs');
+const path = require('path');
+
+const readSource = (relativePath) => fs.readFileSync(
+  path.join(__dirname, '..', relativePath),
+  'utf8'
+);
+
+describe('민감 로그 정적 회귀 방지', () => {
+  it.each([
+    'src/controllers/userController.js',
+    'src/services/userService.js',
+    'src/middlewares/validateMiddleware.js'
+  ])('%s에서 console 호출을 사용하지 않는다', (relativePath) => {
+    expect(readSource(relativePath)).not.toMatch(/console\.(?:log|error|warn|info|debug)\s*\(/);
+  });
+
+  it('연결 테스트가 DB 비밀번호 값을 출력하지 않는다', () => {
+    expect(readSource('tests/connection.test.js')).not.toMatch(
+      /DB_PASSWORD\s*:\s*\$\{process\.env\.DB_PASSWORD\}/
+    );
+  });
+
+  it('앱이 query string을 포함하는 morgan URL이나 error stack을 출력하지 않는다', () => {
+    const appSource = readSource('src/app.js');
+    expect(appSource).not.toMatch(/morgan\s*\(/);
+    expect(appSource).not.toMatch(/err(?:or)?\.stack/);
+  });
+
+  it('logger 메타데이터는 명시적인 allowlist를 사용한다', () => {
+    const loggerSource = readSource('src/utils/loggerFactory.js');
+    expect(loggerSource).toContain('allowedFields');
+    expect(loggerSource).toContain('allowlistedMetadata');
+    expect(loggerSource).not.toMatch(/\b(?:body|query|params|headers|authorization|cookie)\b/);
+  });
+});
