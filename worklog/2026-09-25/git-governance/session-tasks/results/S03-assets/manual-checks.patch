index 0000000000000000000000000000000000000000..c30107729b98914eee47998d371653eb0a988fce
--- /dev/null
+++ b/scripts/git-checks/check.mjs
@@ -0,0 +1,213 @@
+import { spawnSync } from 'node:child_process';
+import { readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+// Retains the four existing patterns; this is not a general credential/DLP scanner.
+const patterns = [
+  ['private-key', /-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----/],
+  ['aws-access-key', /\b(?:AKIA|ASIA)[A-Z0-9]{16}\b/],
+  ['github-token', /\bgh[pousr]_[A-Za-z0-9_]{20,}\b/],
+  ['slack-token', /\bxox[baprs]-[A-Za-z0-9-]{20,}\b/],
+];
+
+export function secretKinds(text) {
+  return patterns.filter(([, pattern]) => pattern.test(text)).map(([kind]) => kind);
+}
+
+function execute(cwd, args) {
+  const result = spawnSync('git', args, {
+    cwd,
+    encoding: null,
+    maxBuffer: 64 * 1024 * 1024,
+    shell: false,
+    env: { ...process.env, GIT_OPTIONAL_LOCKS: '0', GIT_NO_REPLACE_OBJECTS: '1' },
+  });
+  if (result.error) throw new Error('Git execution failed; output suppressed');
+  return result;
+}
+
+function git(cwd, ...args) {
+  const result = execute(cwd, args);
+  if (result.status !== 0) throw new Error(`git ${args[0]} failed; output suppressed`);
+  return result.stdout;
+}
+
+function validateOid(oid) {
+  if (!/^(?:[a-f0-9]{40}|[a-f0-9]{64})$/i.test(oid ?? '')) {
+    throw new Error('Use a full Git object ID');
+  }
+}
+
+function isZero(oid) {
+  return /^0+$/.test(oid);
+}
+
+function inspectText(text, location) {
+  const kinds = secretKinds(text);
+  if (kinds.length) {
+    const safeLocation = secretKinds(location).length ? '<location suppressed>' : location;
+    throw new Error(
+      `secret candidate (${kinds.join(', ')}) in ${safeLocation}; contents suppressed`
+    );
+  }
+}
+
+function counters() {
+  return { scannedCommits: 0, scannedBlobs: 0, skippedBinaryBlobs: 0, skippedGitlinks: 0 };
+}
+
+function rawChanges(bytes) {
+  const fields = bytes.toString('utf8').split('\0');
+  const changes = [];
+  for (let i = 0; i < fields.length && fields[i]; i += 2) {
+    const match = /^:(\d{6}) (\d{6}) ([a-f0-9]+) ([a-f0-9]+) ([A-Z])$/.exec(fields[i]);
+    if (!match || !fields[i + 1]) throw new Error('Cannot parse Git raw changes');
+    if (match[5] === 'U') throw new Error('Resolve unmerged index entries before checking');
+    changes.push({ mode: match[2], oid: match[4], status: match[5] });
+  }
+  return changes;
+}
+
+function inspectChanges(cwd, changes, result) {
+  for (const change of changes) {
+    if (change.status === 'D') continue;
+    if (change.mode === '160000') {
+      result.skippedGitlinks++;
+      continue;
+    }
+    const bytes = git(cwd, 'cat-file', 'blob', change.oid);
+    if (bytes.includes(0)) {
+      result.skippedBinaryBlobs++;
+      continue;
+    }
+    // Indexed symlinks are blobs containing link text; never follow filesystem targets.
+    inspectText(bytes.toString('utf8'), `blob ${change.oid.slice(0, 12)}`);
+    result.scannedBlobs++;
+  }
+}
+
+export function checkStaged(cwd = process.cwd()) {
+  if (execute(cwd, ['diff', '--cached', '--check']).status !== 0) {
+    throw new Error('Staged whitespace/unmerged check failed; output suppressed');
+  }
+  const changes = rawChanges(
+    git(cwd, 'diff', '--cached', '--raw', '-z', '--no-abbrev', '--no-renames')
+  );
+  const result = { ...counters(), stagedPaths: changes.length };
+  inspectChanges(cwd, changes, result);
+  return result;
+}
+
+export function checkMessage(file, cwd = process.cwd()) {
+  inspectText(readFileSync(resolve(cwd, file), 'utf8'), 'commit message file');
+  return { checkedMessages: 1 };
+}
+
+function commitObject(cwd, oid, inspectTags) {
+  validateOid(oid);
+  let current = oid;
+  const seen = new Set();
+  while (!seen.has(current)) {
+    seen.add(current);
+    const type = git(cwd, 'cat-file', '-t', current).toString('utf8').trim();
+    if (type === 'commit') return current;
+    if (type !== 'tag') throw new Error('Only commit and commit-tag histories can be checked');
+    const tag = git(cwd, 'cat-file', 'tag', current).toString('utf8');
+    if (inspectTags) inspectText(tag, `tag ${current.slice(0, 12)}`);
+    current = /^object ([a-f0-9]+)$/m.exec(tag)?.[1];
+    validateOid(current);
+  }
+  throw new Error('Cyclic tag objects cannot be checked');
+}
+
+function scanRange(cwd, base, head, seen, result) {
+  if (git(cwd, 'rev-parse', '--is-shallow-repository').toString('utf8').trim() === 'true') {
+    throw new Error('Complete history is required; shallow checkout cannot be verified');
+  }
+  const tip = commitObject(cwd, head, true);
+  const start = isZero(base) ? null : commitObject(cwd, base, false);
+  const range = start ? `${start}..${tip}` : tip;
+  const commits = git(cwd, 'rev-list', range).toString('utf8').split('\n').filter(Boolean);
+  for (const commit of commits) {
+    if (seen.has(commit)) continue;
+    seen.add(commit);
+    inspectText(
+      git(cwd, 'show', '-s', '--format=%B', commit).toString('utf8'),
+      `commit ${commit.slice(0, 12)}`
+    );
+    const changes = rawChanges(
+      git(
+        cwd,
+        'diff-tree',
+        '--root',
+        '--no-commit-id',
+        '-m',
+        '-r',
+        '--raw',
+        '-z',
+        '--no-abbrev',
+        '--no-renames',
+        commit
+      )
+    );
+    inspectChanges(cwd, changes, result);
+    result.scannedCommits++;
+  }
+}
+
+export function checkCommitRange(base, head, cwd = process.cwd()) {
+  validateOid(base);
+  validateOid(head);
+  const result = counters();
+  scanRange(cwd, base, head, new Set(), result);
+  return { ...result, base: isZero(base) ? null : base, head };
+}
+
+export function checkOutgoingRefs(input, cwd = process.cwd()) {
+  const lines = input.split(/\r?\n/).filter((line) => line.trim());
+  const result = { ...counters(), scannedRefs: 0, deletedRefs: 0, unchangedRefs: 0 };
+  const seen = new Set();
+  for (const line of lines) {
+    const fields = line.trim().split(/\s+/);
+    if (fields.length !== 4) throw new Error('Expected four pre-push input fields');
+    const [, local, , remote] = fields;
+    validateOid(local);
+    validateOid(remote);
+    if (isZero(local)) {
+      result.deletedRefs++;
+      continue;
+    }
+    if (local === remote) {
+      result.unchangedRefs++;
+      continue;
+    }
+    scanRange(cwd, remote, local, seen, result);
+    result.scannedRefs++;
+  }
+  return result;
+}
+
+export async function main(args = process.argv.slice(2), cwd = process.cwd()) {
+  const [command, ...rest] = args;
+  if (command === 'staged' && !rest.length) return checkStaged(cwd);
+  if (command === 'message' && rest.length === 1) return checkMessage(rest[0], cwd);
+  if (command === 'range' && rest.length === 2) return checkCommitRange(rest[0], rest[1], cwd);
+  if (command === 'outgoing' && !rest.length) {
+    let input = '';
+    for await (const chunk of process.stdin) input += chunk;
+    return checkOutgoingRefs(input, cwd);
+  }
+  throw new Error(
+    'usage: node scripts/git-checks/check.mjs staged | message <file> | range <base-oid> <head-oid> | outgoing < pre-push-input'
+  );
+}
+
+if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
+  main()
+    .then((result) => console.log(JSON.stringify(result)))
+    .catch((error) => {
+      console.error(error.message);
+      process.exitCode = 1;
+    });
+}
