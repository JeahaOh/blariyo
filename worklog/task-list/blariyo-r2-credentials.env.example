# R2 credentials storage template. Contains no real credentials.
# Copy to ~/.config/blariyo/r2-credentials.env before entering real values.
# Keep the private copy outside Git with directory mode 700 and file mode 600.
# These are storage labels, not a ready-to-use application deployment config.

# Copy the S3 API endpoint displayed by Cloudflare, including https://.
R2_ENDPOINT=''

# Token: blariyo-private-rw
R2_PRIVATE_BUCKET='blariyo-media-private'
R2_PRIVATE_ACCESS_KEY_ID=''
R2_PRIVATE_SECRET_ACCESS_KEY=''

# Token: blariyo-public-rw
R2_PUBLIC_BUCKET='blariyo-media-public'
R2_PUBLIC_ACCESS_KEY_ID=''
R2_PUBLIC_SECRET_ACCESS_KEY=''

# Token: blariyo-backup-rw
R2_BACKUP_BUCKET='blariyo-backup'
R2_BACKUP_ACCESS_KEY_ID=''
R2_BACKUP_SECRET_ACCESS_KEY=''
